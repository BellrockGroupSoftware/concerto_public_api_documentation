/ai-playwright/qa
/modernisation/tools/exploration-tools/sentry

# horizon.master parity harness captures (HTML/PNG/inventory.json working artefacts)
modernisation/src/Legacy/Concerto.Postbackless.Host/docs/shellparity/

# pbl gate credentials (PBL_CRAWL_PASSWORD is a real premier account) — .env.example is tracked
modernisation/src/Legacy/Concerto.Postbackless.Host.Tests/.env
!modernisation/src/Legacy/Concerto.Postbackless.Host.Tests/.env.example

# per-worktree AppHost Auth0/dev settings (holds the local Auth0 client secret) — .env.example is tracked
modernisation/src/AppHost/.env
!modernisation/src/AppHost/.env.example
/tmp
